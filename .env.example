# Copie para .env e preencha.

# Obrigatorio. Enviado pelos clientes no cabecalho X-API-Token.
PJECALC_API_TOKEN=

PJECALC_HOST=0.0.0.0
PJECALC_PORTA=9300

# Usado so pelo /health para saber se o PJe-Calc esta aberto.
PJECALC_URL=http://localhost:9257/pjecalc/pages/principal.jsf

# Pastas de onde o servico aceita planilhas, separadas por ";". Vazio aceita qualquer pasta.
# Exemplo: J:\01 Pericias\01 Analise Pericial;\\jrsantos\pericias
PJECALC_RAIZES_PERMITIDAS=


# Senha da conta ro-berto@jrspericia.com.br (envio de e-mail do Rôberto)
ROBERTO_SMTP_SENHA=
